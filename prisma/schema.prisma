datasource db {
  provider = "postgresql"
  url      = env("STORAGE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Clinic {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  phone               String
  specialty           String
  googleCalendarToken String?  @map("google_calendar_token")
  googleCalendarId    String?  @map("google_calendar_id")
  workingHours        String   @default("{\"1\":{\"active\":true,\"start\":\"08:00\",\"end\":\"18:00\",\"lunchStart\":\"12:00\",\"lunchEnd\":\"13:00\"},\"2\":{\"active\":true,\"start\":\"08:00\",\"end\":\"18:00\",\"lunchStart\":\"12:00\",\"lunchEnd\":\"13:00\"},\"3\":{\"active\":true,\"start\":\"08:00\",\"end\":\"18:00\",\"lunchStart\":\"12:00\",\"lunchEnd\":\"13:00\"},\"4\":{\"active\":true,\"start\":\"08:00\",\"end\":\"18:00\",\"lunchStart\":\"12:00\",\"lunchEnd\":\"13:00\"},\"5\":{\"active\":true,\"start\":\"08:00\",\"end\":\"18:00\",\"lunchStart\":\"12:00\",\"lunchEnd\":\"13:00\"},\"6\":{\"active\":false,\"start\":\"08:00\",\"end\":\"12:00\",\"lunchStart\":\"\",\"lunchEnd\":\"\"},\"0\":{\"active\":false,\"start\":\"08:00\",\"end\":\"12:00\",\"lunchStart\":\"\",\"lunchEnd\":\"\"}}") @map("working_hours")
  slotDurationMinutes Int      @default(30) @map("slot_duration_minutes")
  minCancelHours      Int      @default(2) @map("min_cancel_hours")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  patients     Patient[]
  appointments Appointment[]
  messages     Message[]

  @@map("clinics")
}

model Patient {
  id        String   @id @default(uuid())
  clinicId  String   @map("clinic_id")
  name      String
  phone     String   // E.164 Ex: +5511999999999
  cpf       String?
  createdAt DateTime @default(now()) @map("created_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  messages     Message[]

  @@unique([clinicId, phone])
  @@map("patients")
}

model Appointment {
  id            String   @id @default(uuid())
  clinicId      String   @map("clinic_id")
  patientId     String   @map("patient_id")
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  status        String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, CANCELED, RESCHEDULED
  googleEventId String?  @map("google_event_id")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Message {
  id        String   @id @default(uuid())
  patientId String   @map("patient_id")
  clinicId  String   @map("clinic_id")
  role      String   // user, assistant, system, tool
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("messages")
}
